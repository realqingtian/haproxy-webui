# 复制为 .env 并修改。以下两项密钥必填,可用 `openssl rand -hex 32` 生成,且两者必须不同
HAPROXY_WEBUI_JWT_SECRET=change-me-to-a-random-64-char-hex-string
# 实例凭据加密密钥(AES-256):v0.6 起必填,不再从 JWT secret 派生;
# 首次配置后启动会自动把历史密文迁移为独立密钥加密
HAPROXY_WEBUI_ENCRYPTION_KEY=change-me-too-keep-separate-from-jwt-secret
HAPROXY_WEBUI_ADMIN_USER=admin
HAPROXY_WEBUI_ADMIN_PASSWORD=admin123
HAPROXY_WEBUI_HTTP_PORT=8081
