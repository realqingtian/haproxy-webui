# 复制为 .env 并修改。JWT 密钥必填,可用 `openssl rand -hex 32` 生成
HAPROXY_WEBUI_JWT_SECRET=change-me-to-a-random-64-char-hex-string
HAPROXY_WEBUI_ADMIN_USER=admin
HAPROXY_WEBUI_ADMIN_PASSWORD=admin123
HAPROXY_WEBUI_HTTP_PORT=8081
# 实例凭据加密密钥(AES-256);缺省时从 JWT secret 派生。建议单独设置
# HAPROXY_WEBUI_ENCRYPTION_KEY=change-me-too
