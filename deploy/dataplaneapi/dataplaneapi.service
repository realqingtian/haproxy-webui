# 每台 HAProxy 节点上运行的 dataplaneapi systemd 服务
# 安装脚本见同目录 install.sh,配置文件 /etc/default/dataplaneapi 可覆盖参数
#
# 安全模型(M5-4 已实机验证):dataplaneapi 以专用非特权用户 dpapi 运行,不再使用 root:
#   1. 节点创建用户:useradd -r -s /usr/sbin/nologin dpapi && usermod -aG haproxy dpapi
#   2. /etc/haproxy 目录 root:dpapi 775、haproxy.cfg root:dpapi 664(dataplaneapi 需写配置)
#   3. /etc/sudoers.d/dpapi:dpapi NOPASSWD 仅允许 systemctl reload/restart haproxy
#   4. haproxy.cfg 的 stats socket 行追加 user dpapi group dpapi(socket 属主)
#   5. ExecStartPre 负责 /tmp 下事务与 spoe 目录的属主(见下方单元)
[Unit]
Description=HAProxy Data Plane API
Documentation=https://www.haproxy.com/documentation/dataplaneapi/
After=network-online.target haproxy.service
Wants=network-online.target

[Service]
Type=simple
User=dpapi
Group=dpapi
# 事务与 spoe 临时目录属主(以 root 前置执行);证书目录供 WebUI「证书管理」使用
ExecStartPre=+/bin/sh -c "mkdir -p /tmp/spoe-haproxy /tmp/haproxy && chown -R dpapi:dpapi /tmp/spoe-haproxy /tmp/haproxy && mkdir -p /etc/haproxy/ssl /etc/haproxy/maps && chown dpapi:dpapi /etc/haproxy/ssl /etc/haproxy/maps"
ExecStart=/usr/local/bin/dataplaneapi \
    --config-file /etc/haproxy/haproxy.cfg \
    --userlist dataplaneapi \
    --host 0.0.0.0 \
    --port 5555 \
    --haproxy-bin /usr/sbin/haproxy \
    --ssl-certs-dir /etc/haproxy/ssl \
    --reload-cmd "sudo systemctl reload haproxy" \
    --restart-cmd "sudo systemctl restart haproxy"
EnvironmentFile=-/etc/default/dataplaneapi
Restart=on-failure
RestartSec=5
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
